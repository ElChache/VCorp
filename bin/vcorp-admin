show_help_role() {
    echo "👤 Your Role: $(echo "$AGENT_ROLE" | tr '-' ' ' | sed 's/\b\w/\U&/g')"
    echo ""
    echo "📋 Getting your role-specific instructions..."
    
    # Get role prompts from API
    role_prompts=$(curl -s "http://localhost:5173/api/agents/$AGENT_ID/prompts")
    
    # Check for API errors
    if echo "$role_prompts" | jq -e '.error' > /dev/null 2>&1; then
        echo "❌ Error: $(echo "$role_prompts" | jq -r '.error')"
        echo ""
        echo "📝 Basic Role Info:"
        echo "   Role Type: $AGENT_ROLE"
        echo "   Agent ID: $AGENT_ID"
        echo "   Project ID: $PROJECT_ID"
        return 1
    fi
    
    # Extract and display role-specific content
    echo "$role_prompts" | jq -r '.prompts[] | select(.type == "role_description") | .content'
}

show_help_workflow() {
    echo "🔧 Development Workflow Guide"
    echo ""
    echo "📋 Getting your development process instructions..."
    
    # Get workflow prompts from API
    workflow_prompts=$(curl -s "http://localhost:5173/api/agents/$AGENT_ID/prompts")
    
    # Check for API errors
    if echo "$workflow_prompts" | jq -e '.error' > /dev/null 2>&1; then
        echo "❌ Error: $(echo "$workflow_prompts" | jq -r '.error')"
        return 1
    fi
    
    # Extract and display workflow content
    echo "$workflow_prompts" | jq -r '.prompts[] | select(.type == "worktree_workflow") | .content'
}

show_help_communication() {
    echo "💬 Team Communication Guidelines"
    echo ""
    echo "📋 Getting your communication protocols..."
    
    # Get communication prompts from API
    comm_prompts=$(curl -s "http://localhost:5173/api/agents/$AGENT_ID/prompts")
    
    # Check for API errors
    if echo "$comm_prompts" | jq -e '.error' > /dev/null 2>&1; then
        echo "❌ Error: $(echo "$comm_prompts" | jq -r '.error')"
        return 1
    fi
    
    # Extract and display communication content
    echo "$comm_prompts" | jq -r '.prompts[] | select(.type == "communication") | .content'
}

show_help_workspace() {
    echo "🏠 Your Workspace & Permissions"
    echo ""
    echo "📂 Workspace Information:"
    echo "   Agent ID: $AGENT_ID"
    echo "   Your Workspace: ./agent_workspaces/$AGENT_ID/"
    echo "   Project Root: ./"
    echo ""
    
    # Show permissions using existing permissions command logic
    CLAUDE_SETTINGS_FILE="./.claude/settings_project${PROJECT_ID}.json"
    
    if [[ ! -f "$CLAUDE_SETTINGS_FILE" ]]; then
        echo "❌ Permissions file not found: $CLAUDE_SETTINGS_FILE"
        echo "This usually means your agent wasn't launched with proper permissions setup."
        return 1
    fi
    
    echo "🔒 Access Rules Summary:"
    echo ""
    
    # Show key permissions
    if command -v jq >/dev/null 2>&1; then
        allow_count=$(jq -r '.permissions.allow | length' "$CLAUDE_SETTINGS_FILE" 2>/dev/null || echo "0")
        deny_count=$(jq -r '.permissions.deny | length' "$CLAUDE_SETTINGS_FILE" 2>/dev/null || echo "0")
        echo "✅ Allowed Operations: $allow_count rules"
        echo "❌ Restricted Operations: $deny_count rules"
        echo ""
        echo "📝 Key Access Areas:"
        echo "   ✅ Your agent workspace (read/write)"
        echo "   👀 Main project files (read-only)"
        echo "   🔧 Development tools (npm, git, etc.)"
        echo "   ❌ Other agents' workspaces (restricted)"
        echo ""
        echo "💡 For detailed permissions: vcorp permissions --detailed"
    else
        echo "⚠️ jq not available - cannot parse permissions"
    fi
}

