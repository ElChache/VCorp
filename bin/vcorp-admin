#!/bin/bash

# VCorp Admin Command - Main script for all VCorp operations
# Usage: vcorp-admin --project=ID --agent=AGENT_ID --role=ROLE_TYPE COMMAND

# Set default port
VCORP_PORT=5173

# Parse command line arguments
PROJECT_ID=""
AGENT_ID=""
AGENT_ROLE=""
COMMAND=""
COMMAND_ARGS=()

while [[ $# -gt 0 ]]; do
    case $1 in
        --project=*)
            PROJECT_ID="${1#*=}"
            shift
            ;;
        --agent=*)
            AGENT_ID="${1#*=}"
            shift
            ;;
        --role=*)
            # Only consume --role= as agent context if no command set yet
            if [[ -z "$COMMAND" ]]; then
                AGENT_ROLE="${1#*=}"
                shift
            else
                COMMAND_ARGS+=("$1")
                shift
            fi
            ;;
        --help)
            # Don't consume --help here, let the command handle it
            if [[ -z "$COMMAND" ]]; then
                SHOW_HELP="true"
                shift
            else
                COMMAND_ARGS+=("$1")
                shift
            fi
            ;;
        *)
            if [[ -z "$COMMAND" ]]; then
                COMMAND="$1"
            else
                COMMAND_ARGS+=("$1")
            fi
            shift
            ;;
    esac
done

# Help functions for each command
show_global_help() {
    echo "🔧 VCorp Command Line Tool - Agent Communication System"
    echo ""
    echo "Usage: vcorp COMMAND [OPTIONS]"
    echo "   or: vcorp --help"
    echo ""
    echo "📋 Available Commands:"
    echo ""
    echo "🗣️  Communication Commands:"
    echo "   reply        Reply to any message/content"
    echo "   message      Send message to channel with assignments"  
    echo "   dm           Send direct message to specific agent"
    echo "   director     Send direct message to Human Director"
    echo "   it           Send message to IT Administrator"
    echo "   document     Create project documents"
    echo "   ticket       Create work tickets with assignments"
    echo ""
    echo "🔍 Information Commands:"
    echo "   help         Get role instructions and function reference"
    echo "   permissions  View your access permissions and workspace"
    echo "   inbox        Check assigned messages and tasks"
    echo "   phase        Check current work assignment"
    echo "   agents       List all project team members"
    echo "   channels     List accessible channels"
    echo "   channel      View messages in specific channel"
    echo "   thread       View full conversation context"
    echo ""
    echo "💡 For detailed help on any command: vcorp COMMAND --help"
    echo "   Example: vcorp message --help"
}

